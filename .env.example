DATABASE_URL=postgresql+asyncpg://episodic:episodic_password@localhost:5432/episodic_db
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development

# File uploads
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# S3 / Cloudflare R2 (only needed when STORAGE_BACKEND=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=us-east-1

# Email (SendGrid) — leave blank in development to log emails to console instead
SENDGRID_API_KEY=
EMAIL_FROM=noreply@episodic.org
EMAIL_FROM_NAME=Episodic
APP_BASE_URL=https://yourdomain.org
